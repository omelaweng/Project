<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <title>Soil Monitoring Dashboard</title>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin-top: 50px;
        }

        .card {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 12px;
            width: 300px;
            margin: auto;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        }

        h1 {
            color: #2b7a78;
        }

        .value {
            font-size: 2em;
            color: #17252a;
        }
    </style>
</head>

<body>
    <h1> Soil Monitoring Dashboard</h1>
    <div class="card">
        <p>ความชื้นในดิน:</p>
        <p class="value" id="moisture">-- %</p>
        <p>อัปเดตล่าสุด: <span id="timestamp">--</span></p>
    </div>

    <script>
        // ===== Firebase Config =====
        const firebaseConfig = {
            apiKey: "AIzaSyCq-zWYfFbUXOzMaWlfebEPxxVEque5Bt8",
            authDomain: "atom-f41d2.firebaseapp.com",
            databaseURL: "https://atom-f41d2-default-rtdb.firebaseio.com",
            projectId: "atom-f41d2",
            storageBucket: "atom-f41d2.firebasestorage.app",
            messagingSenderId: "101816461122",
            appId: "1:101816461122:web:c7ed94b3bdb1d5fa88cadb",
            measurementId: "G-7YCLLGXGEN"

        };

        // เริ่ม Firebase
        firebase.initializeApp(firebaseConfig);
        const db = firebase.database();

        // ดึงข้อมูลจาก path "soilData"
        db.ref("soilData").on("value", (snapshot) => {
            const data = snapshot.val();
            document.getElementById("moisture").innerText = data.moisture + " %";
            document.getElementById("timestamp").innerText = new Date(data.timestamp).toLocaleTimeString();
        });
    </script>
</body>

</html>

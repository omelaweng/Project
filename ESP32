void handleTogglePump() {
  if (!autoMode) {
    pumpStatus = (pumpStatus == 1) ? 0 : 1;
    setPumpState(pumpStatus == 1);

    // อัปเดตสถานะคำสั่ง Firebase
    Firebase.RTDB.setBool(&fbdo, "/commandPump", pumpStatus == 1);
  }
  server.sendHeader("Location", "/");
  server.send(303);
}

void handleToggleMode() {
  autoMode = !autoMode;

  // อัปเดตสถานะคำสั่ง Firebase
  Firebase.RTDB.setBool(&fbdo, "/commandMode", autoMode);

  server.sendHeader("Location", "/");
  server.send(303);
}

void handleData() {

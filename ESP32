void setup() {
  Serial.begin(115200);
  Serial2.begin(115200, SERIAL_8N1, RXD2, TXD2);

  Wire.begin(SDA_PIN, SCL_PIN);

  pinMode(LED_DRY, OUTPUT);
  pinMode(LED_NORMAL, OUTPUT);
  pinMode(LED_WET, OUTPUT);
  pinMode(PUMP_PIN, OUTPUT);
  digitalWrite(PUMP_PIN, LOW);

  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("Starting system...");

  // เชื่อม WiFi ผ่าน WiFiManager
  bool res = wm.autoConnect("ESP32-Setup", "12345678");
  if (!res) {
    Serial.println("WiFi Failed. Restarting...");
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("WiFi Failed!");
    delay(3000);
    ESP.restart();
  }

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("WiFi Connected");
  lcd.setCursor(0, 1);
  lcd.print(WiFi.localIP());
  Serial.print("Connected IP: ");
  Serial.println(WiFi.localIP());
  delay(2000);

  // เริ่มต้น Firebase
  config.api_key = API_KEY;
  config.database_url = DATABASE_URL;
  Firebase.begin(&config, &auth);
  Firebase.reconnectWiFi(true);

  if (!MDNS.begin("esp32")) {
    Serial.println("Error setting up MDNS responder!");
  } else {
    Serial.println("mDNS responder started");
  }

  // กำหนด routing ของ web server
  server.on("/", handleRoot);
  server.on("/togglePump", HTTP_POST, handleTogglePump);
  server.on("/toggleMode", HTTP_POST, handleToggleMode);
  server.on("/data", HTTP_GET, handleData);

  server.begin();
  Serial.println("Web Server Started");
}

void loop() {
  // อ่านข้อมูลจาก Arduino UNO ผ่าน Serial2
  if (Serial2.available()) {
    String input = Serial2.readStringUntil('\n');
    Serial.println("From UNO: " + input);

    int idx = input.indexOf(':');
    if (idx != -1) {
      String valStr = input.substring(idx + 1);
      valStr.trim();
      moisture = valStr.toInt();
    }

    // ควบคุมปั๊มและสถานะดินชื้นตามโหมด
    if (autoMode) {
      if (moisture < 30) {
        setPumpState(true);
        soilStatus = 1; // แห้ง
      } else if (moisture > 60) {
        setPumpState(false);
        soilStatus = 3; // เปียก
      } else {
        setPumpState(false);
        soilStatus = 2; // ปกติ
      }
    } else {
      setPumpState(pumpStatus == 1);
      if (moisture < 30) soilStatus = 1;
      else if (moisture > 60) soilStatus = 3;
      else soilStatus = 2;
    }

    updateLEDs();
    updateLCD();

    // ส่งข้อมูลทุก 20 วินาที
    if (millis() - lastSendTime > sendInterval) {
      sendToThingSpeak(moisture, soilStatus, pumpStatus);

      // ส่งข้อมูลไป Firebase
      Firebase.RTDB.setInt(&fbdo, "/moisture", moisture);
      Firebase.RTDB.setInt(&fbdo, "/soilStatus", soilStatus);
      Firebase.RTDB.setInt(&fbdo, "/pumpStatus", pumpStatus);
      Firebase.RTDB.setBool(&fbdo, "/autoMode", autoMode);

      Serial.println("📤 Sent to Firebase");

      lastSendTime = millis();
    }
  }

  // อ่านคำสั่งจาก Firebase (ถ้ามี)
  if (Firebase.RTDB.getBool(&fbdo, "/commandPump")) {
    bool commandPump = fbdo.boolData();
    if (!autoMode && pumpStatus != (commandPump ? 1 : 0)) {
      pumpStatus = commandPump ? 1 : 0;
      setPumpState(commandPump);
      updateLEDs();
      updateLCD();
      Serial.printf("Pump command from Firebase: %s\n", commandPump ? "ON" : "OFF");
    }
  }

  if (Firebase.RTDB.getBool(&fbdo, "/commandMode")) {
    bool commandMode = fbdo.boolData();
    if (autoMode != commandMode) {
      autoMode = commandMode;
      Serial.printf("Mode command from Firebase: %s\n", autoMode ? "AUTO" : "MANUAL");
      updateLEDs();
      updateLCD();
    }
  }

  server.handleClient();
  delay(300);
}

// ===== Function Implementations =====

void setPumpState(bool on) {
  digitalWrite(PUMP_PIN, on ? HIGH : LOW);
  pumpStatus = on ? 1 : 0;
}

void updateLEDs() {
  digitalWrite(LED_DRY, soilStatus == 1 ? HIGH : LOW);
  digitalWrite(LED_NORMAL, soilStatus == 2 ? HIGH : LOW);
  digitalWrite(LED_WET, soilStatus == 3 ? HIGH : LOW);
}

void updateLCD() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Moisture: " + String(moisture) + "%");

  lcd.setCursor(0, 1);
  switch (soilStatus) {
    case 1: lcd.print("Soil: DRY"); break;
    case 2: lcd.print("Soil: NORMAL"); break;
    case 3: lcd.print("Soil: WET"); break;
    default: lcd.print("Soil: UNKNOWN"); break;
  }

  lcd.setCursor(0, 2);
  lcd.print("Pump: ");
  lcd.print(pumpStatus == 1 ? "ON " : "OFF");

  lcd.setCursor(0, 3);
  lcd.print("Mode: ");
  lcd.print(autoMode ? "AUTO" : "MANUAL");
}


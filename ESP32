  json += "\"soilStatus\":" + String(soilStatus) + ",";
  json += "\"pumpStatus\":" + String(pumpStatus) + ",";
  json += "\"autoMode\":" + String(autoMode ? "true" : "false");
  json += "}";

  server.send(200, "application/json", json);
}

// ===== ThingSpeak ส่งข้อมูล =====
void sendToThingSpeak(int moistureVal, int soilStatusVal, int pumpStatusVal) {
  if ((WiFi.status() == WL_CONNECTED)) {
    HTTPClient http;
    String serverPath = serverName + "?api_key=" + apiKey +
                        "&field1=" + String(moistureVal) +
                        "&field2=" + String(soilStatusVal) +
                        "&field3=" + String(pumpStatusVal);

    http.begin(serverPath.c_str());
    int httpResponseCode = http.GET();

    if (httpResponseCode > 0) {
      String response = http.getString();
      Serial.println("ThingSpeak Response: " + response);
    } else {
      Serial.println("Error sending to ThingSpeak: " + String(httpResponseCode));
    }
    http.end();
  } else {
    Serial.println("WiFi Disconnected");
  }
}
